{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "extensions": {
    "queues": {
      "messageEncoding": "base64",
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:05",
      "maxPollingInterval": "00:00:02"
    }
  },
  "logging": { "logLevel": { "Default": "Warning", "Function": "Information" } }
}
